#!/usr/bin/env bash
#
# config.example.env — relay.sh(接力调度器)配置示例
# 使用方法: 复制为 relay/config.env 并修改，把这个文件和relay.sh一起放你服务器或github action上。
#
# ★ 这份配置属于「接力调度器」relay/relay.sh。
#    relay.sh 必须运行在 CNB 云开发环境【之外】的常开载体上:
#      - 你的本地/云服务器 (crontab 每 30 分钟执行)
#      - 或 GitHub Actions (.github/workflows/relay.yml, 配置放 Secrets)
#    不要把它放进会被回收的云开发环境里, 否则环境回收时守护者自己也死了。
#
# 必需的 CNB CLI 认证(环境变量):
#   export CNB_TOKEN=xxxxx            # 你的 CNB 访问令牌
#   export CNB_API_ENDPOINT=https://api.cnb.cool
# cnb CLI 会自动读取它们(云开发环境内已注入; 外部机器需自行获取令牌)。

# ---- 必填 ----
# 你的 CNB 仓库: <组>/<仓库名>。fork 本仓库后 = 你的用户名/cnb-workspace-always-on
export RELAY_REPO="shifengkj/cnb-workspace-always-on"
export RELAY_PORT="8765"                                  # 服务对外端口(与 deploy/deploy.env 的 PORT 一致)

# ---- 可选(默认值合理, 按需调整) ----
# 守护范围: 只有 RELAY_HOST_BRANCH(常驻分支)与 relay/* 接棒分支上的环境会被守护接力;
#           在 main 等其它分支点「云原生开发」启动的临时环境不会被守护(约 10 分钟自动回收)。
export RELAY_HOST_BRANCH="prod"        # 常驻承载分支(页面「启动常驻服务」按钮所在分支, 需存在于远端)
export RELAY_SOURCE_BRANCH="main"      # 基线分支: 常驻分支不存在时, 首次接力会从它自动派生一次
export RELAY_MAX_RUN_HOURS="18"        # 平台单环境时长硬上限(小时, 仅用于估算回收点, 勿改)
export RELAY_SWITCH_HOURS="17"         # 主动接力寿命: 环境运行满该小时数即切换(默认 17h, 别顶满 18h 极限)
export RELAY_AHEAD="7200"              # 距平台凌晨强制回收点的兜底提前量(秒), 默认 2 小时
export RELAY_POLL="20"                 # 等待新环境就绪的轮询间隔(秒)
export RELAY_READY_TIMEOUT="900"       # 新环境就绪最长等待(秒)
export RELAY_PROBE_TIMEOUT="15"        # HTTP 探活超时(秒)
# export RELAY_GIT_REMOTE="https://oauth2:TOKEN@cnb.cool/组/仓库.git"  # 若 CNB_TOKEN 不适用于 git, 手动指定

# ============================================================
# 本地服务器定时调度示例 (crontab -e, 每 30 分钟执行一次):
#   */30 * * * * cd /path/to/cnb-workspace-always-on/relay && bash relay.sh --apply >> relay.log 2>&1
#
# 首次只观察不改动(推荐先跑几天观察日志):
#   */30 * * * * cd /path/to/cnb-workspace-always-on/relay && bash relay.sh >> relay.log 2>&1
# ============================================================
